# ============================================================
# aster-deploy 环境配置
# 复制并填写: cp .env.example .env
# ============================================================

# === 项目目录 ===
# 所有 aster-* 仓库的父目录
ASTER_REPOS_DIR=/path/to/your/projects

# 覆盖单个项目路径（可选，默认 $ASTER_REPOS_DIR/aster-<name>）
# ASTER_LANG_CORE_DIR=
# ASTER_LANG_EN_DIR=
# ASTER_LANG_ZH_DIR=
# ASTER_LANG_DE_DIR=
# ASTER_LANG_RUNTIME_DIR=
# ASTER_LANG_TRUFFLE_DIR=
# ASTER_API_DIR=
# ASTER_LANG_TS_DIR=
# ASTER_CLOUD_DIR=

# === 工具链 ===
# JAVA_HOME=                  # 自动检测
KUBECONFIG=~/.kube/k3s-config

# === 容器运行时 ===
# Podman 优先，Docker 自动回退
# CONTAINER_RUNTIME=podman

# === 本地端口 (task local / task local:infra) ===
LOCAL_API_PORT=8080
LOCAL_CLOUD_PORT=3000
LOCAL_LSP_PORT=3001
LOCAL_PG_PORT=5432
LOCAL_REDIS_PORT=6379

# === 发布凭证（仅 release 模式）===
GITHUB_TOKEN=                  # GitHub PAT (packages:write)
NPM_TOKEN=                     # npm automation token
DOCKERHUB_USERNAME=wontlost
DOCKERHUB_TOKEN=               # Docker Hub access token

# === Cloudflare（仅 release 模式）===
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# === 容器镜像标签 ===
#
# ★两个变量都**刻意留空**（issue #8 / #9）：可变 tag 是这两条 issue 的共同成因。
#
#   API_IMAGE_TAG：aster-api 生产 Deployment 由 k3s digest-pin 渲染为
#     image@sha256:<digest>，推 jvm-latest 无人拉取 —— task deploy:api 已废弃。
#     发布走源仓 CI 的 image-pin PR 流程。
#
#   LSP_IMAGE_TAG：生产 lsp 是 aster-lsp:0.0.9 + imagePullPolicy: IfNotPresent，
#     往同一 tag 重复推镜像时，有缓存的节点会**静默继续跑旧版本**。
#     必须显式给不可变 tag，例如：
#       task container:lsp LSP_IMAGE_TAG=$(git -C ../aster-cloud rev-parse HEAD)
#     长期方向：由 aster-cloud CI 的 build-lsp-image job 推已签名的 :<sha>。
#
#   ⚠️ 若你的本地 .env 里仍留着 `LSP_IMAGE_TAG=0.0.9`，请删掉那一行 ——
#     否则 container:lsp 的不可变 tag 守卫会被它绕过。
API_IMAGE_TAG=
LSP_IMAGE_TAG=

# === K3S 命名空间 ===
K3S_API_NAMESPACE=aster-cloud
K3S_LSP_NAMESPACE=aster-lsp

# === 测试模式（task local:test）===
# 以下变量由 podman-compose.test.yml 自动设置，无需手动配置:
#   ASTER_SECURITY_SIGNATURE_ENABLED=false  — 禁用 HMAC 签名
#   ASTER_SECURITY_RBAC_ENABLED=false       — 禁用 RBAC
#   ASTER_RATELIMIT_ENABLED=false           — 禁用限流
#   ASTER_PII_ENFORCE=false                 — 禁用 PII 保护
#   ASTER_TENANT_STRICT_FORMAT=false        — 禁用租户格式校验
# 测试用户: test@aster.dev / test1234

# === Grafana (R21 P0 fix: no plaintext in VCS) ===
# Grafana admin login (dev defaults; rotate for staging/prod)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin

# Postgres datasource creds — datasource.yml reads ${GF_POSTGRES_*}.
# Default values match dev podman-compose Postgres; rotate via Vault in prod.
GF_POSTGRES_USER=postgres
GF_POSTGRES_PASSWORD=postgres
GF_POSTGRES_DB=aster_policy
