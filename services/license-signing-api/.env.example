PORT=8443
VAULT_ADDR=https://vault.internal:8200
VAULT_TOKEN=<service token with ONLY transit/sign/license-signing-*, transit/sign/revocation-signing-* update permissions>
JWT_ISSUER=https://idp.aster.com
JWT_AUDIENCE=aster-license-signing-api
JWT_JWKS_URL=https://idp.aster.com/.well-known/jwks.json
ALLOWED_KEY_IDS=^(license|revocation)-signing-v2-[0-9]{4}-[0-9]{2}$
AUDIT_LOG_PATH=/var/log/license-signing-api/audit.jsonl
LICENSES_SLACK_WEBHOOK=
LOG_LEVEL=info
